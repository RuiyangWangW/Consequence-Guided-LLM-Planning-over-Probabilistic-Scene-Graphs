# Trained adapters: ~78 MB each for a 1.7B, 137 MB for a 4B, and reproducible in 14-70
# minutes from `finetune_extraction.py` plus the seed in `training.json`. The RSN
# checkpoint is the exception - it is small and nothing here retrains it.
models/*
!models/rsn_cal.pt

# Rendered output: floor-plan graphs, run traces, GIFs. All regenerable, 400 MB of it.
figures/

# Run output rather than input.
logs/
__pycache__/
*.pyc

# Generated training splits - `extraction_data.py --n N --seed S --exclude-benchmark`
# rebuilds any of them byte-for-byte, and the training set alone is 2.7 MB.
data/extraction-train.json
data/extraction-val.json
data/extraction-dev.json

# Measurements. Kept out because they are the *result* of a run, not its input, and
# there are dozens; `data/tasks.json` and `data/reference-sim.json` are the exceptions,
# because the first *is* the benchmark and the second is the evidence every task in it
# can actually be done.
data/eval-*.json
data/evaluation*.json
data/extraction-bench-*.json
data/extraction-dev-*.json
data/extraction-final-*.json
data/extraction-ft-*.json
data/extraction-h1.json
data/extraction-rel-*.json
data/extraction-results.json
data/extraction-longplus-*.json
data/before-*/
data/pre-*/
data/prompted-extractor/
data/*.bak
data/tasks.json.*
data/v[0-9]-*.json
data/exp-*.json
data/ladder/
data/order-oracle*.json
data/multi-4b*.json
data/spread-headroom.json

# Papers and other reference material that is not an input to anything here.
docs/


# API credentials - never commit
.behavior_api_keys
*api_keys*

# benchmark construction - kept locally, not published
BENCHMARK.md
